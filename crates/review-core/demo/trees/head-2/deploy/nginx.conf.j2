# {{ ansible_managed }}
upstream ledger {
{% for host in groups['ledger'] %}
    server {{ hostvars[host]['ansible_host'] }}:{{ ledger_port }};
{% endfor %}
}

server {
    listen 80;
    server_name {{ server_name }};
{% if tls_enabled %}
    listen 443 ssl;
    ssl_certificate     {{ tls_certificate }};
    ssl_certificate_key {{ tls_certificate_key }};
{% endif %}

    client_max_body_size {{ upload_limit | default('10m') }};

    location / {
        proxy_pass http://ledger;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}
