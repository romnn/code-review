environments:
  staging:
    values:
      - environments/staging.yaml
  production:
    values:
      - environments/production.yaml
---
repositories:
  - name: bitnami
    url: https://charts.bitnami.com/bitnami

releases:
  - name: ledger
    namespace: {{ .Values.namespace | default "ledger" }}
    chart: ./chart
    values:
      - replicaCount: {{ .Values.replicas }}
        image:
          tag: {{ requiredEnv "LEDGER_IMAGE_TAG" | quote }}
        ingress:
          enabled: {{ eq .Environment.Name "production" }}
    needs:
      - {{ .Values.namespace | default "ledger" }}/postgres

  - name: postgres
    namespace: {{ .Values.namespace | default "ledger" }}
    chart: bitnami/postgresql
    version: 15.5.38
    set:
      - name: auth.database
        value: ledger
      - name: auth.password
        value: {{ requiredEnv "LEDGER_DB_PASSWORD" | quote }}
