<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for?(:title) ? yield(:title) : "Ledger" %></title>
    <%= stylesheet_link_tag "application" %>
  </head>
  <body>
    <% flash.each do |kind, message| %>
      <div class="flash <%= kind %>"><%= message %></div>
    <% end %>
    <%= yield %>
  </body>
</html>
