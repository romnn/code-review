# Walks the built-in demo in review-tui as smoke.qa walks it in review-gui, sharing
# smoke-common.qa with it: files, one file's diff, hunks approved and flagged and folded, the
# whole file as a buffer with find, the cheat sheet and the overview, the `/` bars, the pickers,
# the settings list, diff styles, side by side and its narrow fallback, panning, the mouse
# (selections and copies, clicks, the divider, the wheel), density from the configuration,
# folded folders kept across launches, input racing background work, the screen modes, a
# refresh, pastes that must not act as keys, a terminal too narrow for a field, and marks
# still saving when the reviewer quits.
# Run with `task qa:tui -- scripts/qa/smoke-tui.qa`; the screen lands in target/qa/tui/ as
# .txt and .ansi files.
# Positions in `state` are terminal cells on a 160×50 screen: the files pane is columns 0 to
# 31, the divider column 32, and the diff's rows start at column 33 on row 1.

launch --demo
expect "revision":"1"
expect "mode":"Tree"
expect "theme":"carbonfox"
expect "token_emphasis":false,"diff_style":"bold"
expect "progress":\{"files":\[6,17\],"hunks":\[13,27\],"auto_approved":6\}
expect "layout":\{"sidebar":32\}
expect "viewport":\[33,1,127,47\]
shot 01-open

include scripts/qa/smoke-common.qa

# Clicks under an overlay do nothing either: hash.rs's row sits under the sheet.
click 10 17
state
expect "selected":"src/engine.rs"
expect "overlay":"Help"
# The sheet scrolls with the keys where it is taller than the screen, and closes with Escape.
resize 100x24
key j j
state
expect "sheet":\{"offset":2,
key ctrl-d
state
expect "sheet":\{"offset":1[0-9],
shot 05b-help-scrolled
resize 160x50
key escape
state
expect "overlay":null

# The overview owns the keyboard too, and scrolls the same way.
key i
key space
state
expect "overlay":"Overview"
expect "hunk_badges":\["Unreviewed"\]
shot 12-overview
resize 160x20
key j
state
expect "sheet":\{"offset":1,
resize 160x50
key q
state
expect "overlay":null

# za folds the selected hunk to its header and unfolds it again, keeping the place; a hunk
# unfolded by hand stays open once approved.
state
expect "row_count":38,
key z a
state
expect "row_count":26,
expect "hunk":1,
key z a
state
expect "row_count":38,

# The mouse in the diff: a drag selects text across rows, which goes to the primary selection
# when the button comes up, and Ctrl+C copies it; a press on a hunk's header selects that
# hunk, and one on a rule of unchanged lines shows more of them.
drag 45 6 60 8
state
expect "selection":\{"pane":"Diff","column":"Whole","anchor":\[5,4\],"head":\[7,19\]\}
primary
expect ^"pub fn apply_batch\(&mut self, entries: &\[Entry\]\) -> usize \{\\n
key ctrl-c
clipboard
expect ^"pub fn apply_batch
state
expect "status":"Copied 3 lines\."
shot 16-selection
click 50 17
state
expect "hunk":2,
click 50 3
state
expect "row_count":52,
click 50 3
state
expect "row_count":52,

# Shift with a press extends the selection from where it started.
click 45 20
click 60 22 shift
state
expect "selection":\{"pane":"Diff","column":"Whole","anchor":\[19,
key escape

# A paste is text for a field, never keys: a pasted space in the files does not approve.
paste " "
state
expect "mode":"Tree"
expect "pending":0,"queued":0
expect "path":"src/engine.rs","kind":"File","change":"M","progress":"Partial"
expect "status":"Pasted text ignored
# A paste into the `/` filter types it.
key /
paste "eng"
state
expect "query":"eng","editing":true
key escape
state
expect "filter":null

# `/` in the tree filters it as lazygit does: typing narrows it, Enter keeps the filter and
# returns to the list, Esc clears it.
key /
key f o r m
state
expect "area":"Find"
expect "query":"form","editing":true
expect "selected":"src/format.rs"
expect "tree":\[\{"path":"src","kind":"Directory".*\{"path":"src/format.rs","kind":"File".*\],"tree_cursor"
shot 10-tree-filter
key enter
state
expect "area":"Tree"
expect "query":"form","editing":false
key escape
state
expect "filter":null
expect "path":"src/engine.rs"

# `/` in the diff searches its code without leaving it; n and N step through the matches and
# the selected hunk follows.
file src/engine.rs
key u
key 0
key /
key b a l a n c e
key enter
key n
key n
state
expect "mode":"Diff"
expect "target":"Diff","query":"balance","matches":7,"current":3
expect "hunk":2,
expect "status":"Match 4 of 7"
shot 11-diff-find
key escape

# Unified lines pan sideways with the code alone, and a line clipped at the right edge ends in
# a marker; another file starts back at the left edge.
resize 100x50
file src/engine.rs
key 0
state
expect "text_offset":0\.0,"text_extent":[1-9]
shot 17-clipped
key shift-right
state
expect "text_offset":2[0-9]\.0,
shot 17b-panned
key z shift-h
state
expect "text_offset":0\.0,
wheel 2 60 10 shift
state
expect "text_offset":12\.0,
file src/parser.rs
state
expect "text_offset":0\.0,
file src/engine.rs

# The buffer's code follows its cursor sideways, and pans with the same keys.
key 0
key =
key /
key u s i z e : : M A X
key enter
state
expect "line":"        let take = entries.len\(\).min\(usize::try_from\(LIMIT\)
expect "buffer_offset":1[0-9]\.0
shot 18-buffer-panned
key g g
state
expect "buffer_offset":0\.0
key escape
key escape
resize 160x50

# A fresh demo for what follows, apart from the gaps shown and the marks made above.
launch --demo

# `|` cycles the diff styles, which are colors only: no style moves a row.
file src/engine.rs
key 0
state
expect "density":"normal"
expect "row_count":26,"rows":\[\{"row":0,"source":0,"kind":"Header","hunk":0,"y":1,
key |
state
expect "diff_style":"soft"
expect "headers":"chips","change_bar":true
expect "row_count":26,"rows":\[\{"row":0,"source":0,"kind":"Header","hunk":0,"y":1,
shot 06-soft
key |
state
expect "diff_style":"plain"
expect "syntax":false,"background":"none"
expect "row_count":26,"rows":\[\{"row":0,"source":0,"kind":"Header","hunk":0,"y":1,
shot 06-plain
key |
state
expect "diff_style":"bold"

# Side by side: removed lines beside added ones, each side with its own line numbers; a
# selection in a half copies that side only; when the diff gets too narrow it shows unified
# without changing the remembered layout, and side by side comes back when it is wide enough
# again. Panning moves only code.
key s
state
expect "layout":"side-by-side","effective_layout":"side-by-side"
expect "row_count":19,
expect "kind":"Pair"
shot 11-side-by-side
drag 110 12 140 14
state
expect "column":"Right"
pan 10
state
expect "text_offset":10\.0
shot 11a-side-by-side-panned
resize 90x50
state
expect "layout":"side-by-side","effective_layout":"unified"
expect "viewport":\[33,1,57,47\]
expect "selection":null
shot 11c-narrow
resize 160x50
state
expect "effective_layout":"side-by-side"

# Side by side, `/` finds each half's code apart, the base's half first in each row, and
# highlights a match only in its own half.
key /
key b a l a n c e
key enter
state
expect "target":"Diff","query":"balance","matches":[0-9]+,"current":[0-9]+,"current_column":"Left"
key n
state
expect "current_column":"Right"
shot 11b-side-by-side-find
key escape
key s
state
expect "layout":"unified"

# Ctrl+P finds a file by a fuzzy match of its path; Escape gives the list the keys, a click
# selects an entry and Enter opens it in the diff.
key ctrl-p
key e n g
state
expect "overlay":"Picker"
expect "area":"Picker"
expect "kind":"Files","scope":"Changed","query":"eng"
expect "entries":\[\{"path":"src/engine.rs","line":null,"text":"","changed":true\},\{"path":"config/settings.json"
shot 12-file-finder
key escape
state
expect "area":"PickerList"
click 30 6
state
expect "selected":1,
key k
key enter
state
expect "overlay":null
expect "mode":"Diff"
expect "selected":"src/engine.rs"

# Ctrl+G searches contents with a preview; a hit inside a hunk opens the diff at that hunk, and
# Tab widens the search to the whole tree, whose unchanged files open read-only.
key ctrl-g
key r e c o n c i l e
state
expect "kind":"Content","scope":"Changed","query":"reconcile"
expect "path":"src/engine.rs","line":43
shot 13-content-search
key enter
state
expect "mode":"Diff"
expect "hunk":2,
expect "status":"src/engine.rs:44"
key ctrl-g
key tab
key t i n y
state
expect "scope":"Tree"
expect "path":"README.md","line":2
key enter
state
expect "mode":"Buffer"
expect "title":"README.md"
expect "row":2,"col":2
shot 13b-unchanged-file
key escape

# Enter typed before the search answers opens the newest query's first hit, not an older one;
# a double click on an entry opens it as well.
key ctrl-g
key r e c o n c i l e enter
state
expect "overlay":null
expect "status":"src/engine.rs:44"
key ctrl-p
key l i b
click 30 5 2
state
expect "overlay":null
expect "selected":"src/lib.rs"

# The settings list: T opens it on the theme in use and j previews the next one; Escape drops
# the preview and keeps what was applied. The terminal has no font sizes to offer.
key escape
key shift-t
state
expect "overlay":"Settings"
expect "cursor":"Theme: Carbonfox"
expect "entries":23\}
expect "geometry":\{"width":32,"list_top":3,"cursor_top":4\}
key j
state
expect "theme":"tokyonight-night"
expect "applied_theme":"carbonfox","previewing":true
expect "geometry":\{"width":32,"list_top":3,"cursor_top":5\}
shot 08-tokyonight
key escape
state
expect "overlay":null
expect "theme":"carbonfox"

# Apply, then preview, then Escape: the applied theme stays and only the preview goes.
key ,
key j
key space
state
expect "applied_theme":"tokyonight-night","previewing":false
key j
state
expect "theme":"nightfox"
key escape
state
expect "overlay":null
expect "theme":"tokyonight-night"

# The search field takes every typed key, q, i, ? and space included; Escape goes back to the
# list, keeping the search, and Escape again closes it.
key ,
key tab
key q i ? space
state
expect "overlay":"Settings"
expect "query":"qi\? ","searching":true
key escape
state
expect "overlay":"Settings"
expect "searching":false
key escape
state
expect "overlay":null

# Every entry previews while the cursor rests on it, the layout through the same transition as
# `s`; Escape drops the preview back to what was applied.
key ,
key tab
key l a y o u t space s i d e
state
expect "cursor":"Layout: side by side"
expect "layout":"side-by-side","effective_layout":"side-by-side"
expect "previewing":true
key escape
key escape
state
expect "overlay":null
expect "layout":"unified","effective_layout":"unified"
expect "previewing":false

# A press on an entry applies it; one on the search gives it the keys, as Tab does; one beside
# the panel closes it and gives the keys back to the mode.
key ,
click 10 4
state
expect "applied_theme":"carbonfox"
click 10 1
key z j q
state
expect "query":"zjq","searching":true
key escape
click 100 20
state
expect "overlay":null

# Approving a whole file from the tree, as lazygit stages one.
file src/engine.rs
key escape
key space
state
expect "path":"src/engine.rs","kind":"File","change":"M","progress":"Done"
shot 07-file-done

# Approved hunks fold to their headers; zA shows them like any other and folds them again.
state
expect "approved":"folded"
expect "row_count":3,"rows":\[\{"row":0,"source":0,"kind":"Header"
key z shift-a
state
expect "approved":"shown"
expect "status":"Approved hunks shown\."
expect "row_count":48,
shot 07b-approved-shown
key z shift-a
state
expect "approved":"folded"
expect "row_count":3,

# The mouse in the files: a click on a tree row shows that file, a double click opens its
# diff, and the wheel scrolls the list under it, three rows a turn, on a screen too short for
# all of it.
click 10 17
state
expect "selected":"src/format.rs"
expect "mode":"Tree"
click 10 17 2
state
expect "selected":"src/format.rs"
expect "mode":"Diff"
file src/compat.rs
resize 160x12
wheel 2
state
expect "scroll_offset":6\.0,
wheel -1
state
expect "scroll_offset":3\.0,
wheel 1 10 6
state
expect "tree":\[\{"path":"assets","kind":"Directory","change":null,"progress":"Open","y":1\}
resize 160x50

# The divider between the files and the diff drags, which the next launch remembers, and a
# double click puts it back.
drag 32 20 40 20
state
expect "layout":\{"sidebar":40\}
expect "viewport":\[41,1,119,47\]
click 40 20 2
state
expect "layout":\{"sidebar":32\}

# Screen modes: the diff across the whole width, and back; Ctrl+B hides the files and shows
# them again, remembering it in review-tui's own width setting.
key +
state
expect "screen":"Full"
expect "layout":\{"sidebar":null\}
expect "viewport":\[0,1,160,47\]
shot 12-full
key _
state
expect "screen":"Split"
expect "layout":\{"sidebar":32\}
key ctrl-b
state
expect "screen":"Full"
expect "mode":"Diff"
key ctrl-b
state
expect "screen":"Split"
expect "layout":\{"sidebar":32\}

# R fetches; the demo has nothing newer.
key shift-r
state
expect "status":"Up to date; no new revision\."

# Holding j in the tree previews files without building every diff; a space right after the
# burst approves exactly the file whose diff shows.
key escape
file src/generated/schema.rs
rapid key j
rapid key j
rapid key j
rapid state
expect "preview":true
rapid key space
state
expect "selected":"src/format.rs"
expect "shown":"src/format.rs"
expect "path":"src/format.rs","kind":"File","change":"A","progress":"Done"

# Folded folders are saved with the review: the relaunch below, on the same data, folds them
# again.
file src/generated/schema.rs
key h
key h
state
expect "collapsed":\["src/generated"\]
shot 14-folded

# Revision 2 simulates a force-push: approvals carry over where the code is unchanged, and
# hunks that changed since they were reviewed say so.
launch --demo-revision 2
expect "revision":"2"
expect "collapsed":\["src/generated"\]
file src/engine.rs
find changed since
state
expect "tag":"changed since revision 1"
shot 09-revision-2

# A mark that lands while a held key previews a file by its header never builds that file's
# diff early: it still opens at its first hunk that needs the reviewer once the cursor rests.
launch --demo
file src/generated/schema.rs
rapid key j
rapid key space
rapid key j
rapid state
expect "selected":"src/engine.rs","shown":"src/engine.rs","preview":true
state
expect "selected":"src/engine.rs"
expect "hunk":1,

# The density comes from the configuration: compact rows leave out the blank row before each
# hunk, which the normal density's 38 rows of this file have.
launch --demo --config scripts/qa/compact.toml
expect "density":"compact","effective_density":"compact"
file src/engine.rs
state
expect "row_count":25,
expect "kind":"Gap".*"kind":"Header"
shot 15-compact

# A terminal too narrow to give the file finder's query any cells still draws it, cursor and
# all.
resize 30x12
key ctrl-p
key e n g
state
expect "overlay":"Picker"
expect "query":"eng"
shot 31-narrow-picker
key escape
key escape
resize 160x50

include scripts/qa/smoke-quit.qa
