# What both front ends check alike, from the demo's first launch on: one file's diff, its
# hunks approved, flagged and reset, the whole file as a buffer with find, and an overlay that
# owns the keyboard.
# Every expectation reads the same in review-gui and review-tui: nothing here depends on the
# geometry, which each measures in its own units.
# smoke.qa and smoke-tui.qa include it right after launching the demo.

# The diff opens on whole files; this walk reads each hunk apart under its header, as `v`
# shows it, which later launches remember. smoke-file.qa walks the whole file. A pull request
# review shows its pushed heads and never follows a working tree.
state
expect "view":"file","effective_view":"file"
expect "live":null
key v
state
expect "view":"hunks","effective_view":"hunks"

# A changed PDF is one unit that diffs its pages' text: its first changed page pair shows under
# a page navigator, rendered side by side above it; } steps to the next pair, an added page
# whose base says so. P hides the pages and shows them again.
file web/manual.pdf
state
expect "pages":"Base 2/6 → Head 2/7 · text changed"
expect "text":"Base 2/6 → Head 2/7 · text changed · \} next page · \{ previous · P hides the page
expect "comparison":\{"base":\{"detail":"PDF page 2 · 298 × 420 pt","note":null
action NextPage
action NextPage
state
expect "pages":"Head 4/7 · added page"
expect "comparison":\{"base":\{"detail":"","note":"none: the page is new"
action TogglePages
state
expect "comparison":null
action TogglePages
state
expect "comparison":\{"base":\{"detail":"","note":"none: the page is new"

# A binary file that is no image keeps its binary line, with no image comparison above it.
file assets/logo.bin
state
expect "selected":"assets/logo.bin"
expect "comparison":null

# A changed image compares its versions side by side, counts the pixels that changed, and
# tints them over the head with o; a second o shows the head as it is.
file web/images/chart.png
state
expect "comparison":\{"base":\{"detail":"PNG · 96 × 64","note":null,"size":
expect "status":"672 of 6144 pixels changed \(10.9%\) · o tints them"
action ToggleChangedPixels
state
expect "tinted":true
action ToggleChangedPixels
state
expect "tinted":false

# Moving through the files previews each one's diff.
file src/engine.rs
state
expect "selected":"src/engine.rs"
# A folder holding only one folder shows as one row with it, as `.github/workflows` does.
expect "tree":\[\{"path":".github/workflows","kind":"Directory"
expect \{"path":"db/migrations","kind":"Directory"
expect "hunks":3
expect "scope":"impl Ledger › fn apply_batch"
# The brace reflow at lines 27–29 is proven formatting-only beside the file's real changes, so
# it is approved automatically, without a mark, and folds like an approved hunk.
expect "text":"L27–29","tag":"reformatted only · auto-approved"
expect "sync":"rev 1 · [0-9a-f]{7} · synced just now"
expect "files_header":"#128 feature/reconcile"
shot 02-engine

# The diff starts at the first hunk that needs the reviewer, past the reflow; j/k move
# between hunks.
key 0
state
expect "mode":"Diff"
expect "hunk":2,"hunks"
expect "hunk_badges":\["Unreviewed"\]
key k
state
expect "hunk":1,"hunks"
expect "hunk_badges":\["Auto"\]
shot 03-auto-approved
# Space on the reflow records an explicit reset, so it needs review; space then approves it
# by hand and moves on to the next hunk that needs the reviewer.
key space
state
expect "hunk_badges":\["Unreviewed"\]
expect "tag":"reformatted only"
key space
state
expect "hunk":2,"hunks"
key k
state
expect "hunk":1,"hunks"
expect "hunk_badges":\["Accepted"\]
shot 03-approved
# Space again takes it back; ! flags and u resets.
key space
state
expect "hunk_badges":\["Unreviewed"\]
key !
state
expect "hunk_badges":\["Flagged"\]
key u
state
expect "hunk_badges":\["Unreviewed"\]

# The whole file as a read-only buffer, at the selected hunk, with vim motions and find.
key =
state
expect "mode":"Buffer"
expect "row":26,
key j
key w
state
expect "row":27,"col":12
expect "scope":"impl Ledger › fn apply_batch"
key /
key b a l a n c e
key enter
key n
state
expect "query":"balance","matches":12
expect "scope":"impl Ledger › fn balance"
expect "editing":false
shot 04-buffer-find
key escape
key escape
state
expect "mode":"Diff"
expect "hunk":1,"hunks"

# Tab and Shift+Tab switch between the files and the code, and the buffer's Tab goes to the
# files too.
key tab
state
expect "mode":"Tree"
expect "area":"Tree"
key shift-tab
state
expect "mode":"Diff"
expect "hunk":1,"hunks"
key =
key tab
state
expect "mode":"Tree"
key tab
state
expect "mode":"Diff"

# w wraps the diff's long lines onto rows of their own, and w again cuts them.
key w
state
expect "wrap":true
key w
state
expect "wrap":false

# j and k step through the hunks in the diff; n and N step through the files in the tree's
# order: from the diff each file shows at its first hunk that needs the reviewer, and in the
# tree the cursor moves and previews it.
key j
state
expect "hunk":2,"hunks"
key k
state
expect "hunk":1,"hunks"
key n
state
expect "selected":"src/format.rs"
expect "mode":"Diff"
key shift-n
state
expect "selected":"src/engine.rs"
expect "hunk":1,"hunks"
# A folded folder's files are skipped whole: around the folded src/, N and n go from the file
# before it to the file after it.
key tab
key h h
state
expect "collapsed":\["src"\]
key shift-n
state
expect "selected":"scripts/release.sh"
# A shell script is highlighted too, as every common file type is.
expect "highlighted":true
key n
state
expect "selected":"tools/notify.rb"
shot 06-next-file-past-folded
key z shift-r
# On a folder, the diff shows every change of the folder's files, each under its path, and
# Tab opens the file under its reading line, so the diff's keys act on one file.
file src/compat.rs
key escape
key k
key k
key k
state
expect "mode":"Tree"
expect "folder":"src"
expect "rows":\[\{"row":0,"source":0,"kind":"FileHeader"
shot 06-folder-diff
key tab
state
expect "mode":"Diff"
expect "selected":"src/generated/schema.rs","shown":"src/generated/schema.rs","folder":null
file src/engine.rs
key 0
state
expect "mode":"Diff"
expect "hunk":1,"hunks"

# The demo reviews a range, whose code is not on disk: language servers run only in a checkout,
# so Ctrl+T has nothing to trust and go to definition says why it cannot run, asking for no
# trust.
key ctrl-t
state
expect "overlay":null
expect "trusted":false
expect "status":"Language servers run only in a checkout
key =
key g d
state
expect "mode":"Buffer"
expect "overlay":null
expect "status":"Go to definition needs the code on disk\.
key =
state
expect "mode":"Diff"
expect "hunk":1,"hunks"

# Overlays own the keyboard: review keys under them do nothing.
key ?
key space
key j
state
expect "overlay":"Help"
expect "hunk":1,"hunks"
expect "hunk_badges":\["Unreviewed"\]
shot 05-help
