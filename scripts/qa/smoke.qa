# Walks the built-in demo the lazygit way: files, one file's diff, hunks approved and flagged,
# the whole file as a buffer, overlays, input racing background work, window chrome, diff
# styles, the settings list with its previews, side by side, and a force-push. Run
# with `task qa -- scripts/qa/smoke.qa`; screenshots land in target/qa/.

launch --demo
expect "revision":"1"
expect "mode":"Tree"
expect "client_decorated":true
expect "theme":"carbonfox"
expect "token_emphasis":false,"diff_style":"bold"
expect "progress":\{"files":\[6,52\],"hunks":\[13,74\],"auto_approved":6\}
shot 01-open

include scripts/qa/smoke-common.qa

# Clicks under an overlay do nothing either: hash.rs's row sits under the sheet.
click 100 445
state
expect "selected":"src/engine.rs"
expect "overlay":"Help"
key escape
key i
key space
state
expect "overlay":"Overview"
expect "hunk_badges":\["Unreviewed"\]
key q
state
expect "overlay":null

# Input racing background work: approve, then leave for other files before the mark is saved.
# The mark lands on exactly the hunk approved, and the view follows the latest selection.
rapid key space
rapid key escape
rapid key j
rapid key j
state
expect "mode":"Tree"
expect "selected":"src/hash.rs"
expect "pending":0,"queued":0
expect "path":"src/engine.rs","kind":"File","change":"M","progress":"Partial"
file src/engine.rs
key 0
state
expect "hunk":2,
key k
state
expect "hunk_badges":\["Accepted"\]

# `|` cycles the diff styles, which are colors only: soft (Zed's muted look with chips), plain
# (lazygit's red and green text) and back to bold (delta's). No style moves a row: the rows,
# their height and their places stay as they were.
state
expect "density":"normal"
expect "row_count":26,"rows":\[\{"row":0,"source":0,"kind":"Header","hunk":0,"y":82.0,
expect "row_height":28.0
key |
state
expect "diff_style":"soft"
expect "background":"muted","change_bar":false
expect "density":"normal"
expect "row_count":26,"rows":\[\{"row":0,"source":0,"kind":"Header","hunk":0,"y":82.0,
expect "row_height":28.0
shot 06-soft
key |
state
expect "diff_style":"plain"
expect "syntax":false,"background":"none"
expect "row_count":26,"rows":\[\{"row":0,"source":0,"kind":"Header","hunk":0,"y":82.0,
shot 06-plain
key |
state
expect "diff_style":"bold"
expect "row_count":26,"rows":\[\{"row":0,"source":0,"kind":"Header","hunk":0,"y":82.0,

# Side by side: removed lines beside added ones, each side with its own line numbers; a
# selection in a half copies that side only, and when the diff gets too narrow it shows
# unified, dropping the selection rather than letting it copy other text.
key s
state
expect "layout":"side-by-side","effective_layout":"side-by-side"
expect "kind":"Pair"
shot 11-side-by-side
drag 1110 280 1300 360
state
expect "column":"Right"
key ctrl-= ctrl-= ctrl-= ctrl-= ctrl-= ctrl-= ctrl-= ctrl-=
state
expect "layout":"side-by-side","effective_layout":"unified"
expect "selection":null
key ctrl-0
state
expect "effective_layout":"side-by-side"
key s
state
expect "layout":"unified"

# Approving a whole file from the tree, as lazygit stages one.
key escape
key space
state
expect "path":"src/engine.rs","kind":"File","change":"M","progress":"Done"
shot 07-file-done

# Approved hunks fold to their headers, and unchanged lines between folded hunks show nothing,
# so the done file reads as a list of headers. zA shows approved hunks like any other, keeping
# the place, and folds them again.
state
expect "approved":"folded"
expect "row_count":3,"rows":\[\{"row":0,"source":0,"kind":"Header"
key z shift-a
state
expect "approved":"shown"
expect "status":"Approved hunks shown\."
expect "row_count":50,
shot 07b-approved-shown
key z shift-a
state
expect "approved":"folded"
expect "row_count":3,

# The settings list: T opens it on the theme in use and j previews the next one; Escape drops
# the preview and keeps what was applied.
key shift-t
state
expect "overlay":"Settings"
expect "cursor":"Theme: Carbonfox"
key j
state
expect "theme":"tokyonight-night"
expect "applied_theme":"carbonfox","previewing":true
shot 08-tokyonight
key escape
state
expect "overlay":null
expect "theme":"carbonfox"

# Apply, then preview, then Escape: the applied theme stays and only the preview goes.
key ,
key j
key space
state
expect "applied_theme":"tokyonight-night","previewing":false
key j
state
expect "theme":"nightfox"
key escape
state
expect "overlay":null
expect "theme":"tokyonight-night"

# The search field takes every typed key, q, i, ? and space included; Escape goes back to the
# list, keeping the search, and Escape again closes it.
key ,
key tab
key q i ? space
state
expect "overlay":"Settings"
expect "query":"qi\? ","searching":true
key escape
state
expect "overlay":"Settings"
expect "searching":false
key escape
state
expect "overlay":null

# Every entry previews while the cursor rests on it: the layout through the same transition as
# `s`, and token emphasis; Escape drops the preview back to what was applied.
key ,
key tab
key l a y o u t space s i d e
state
expect "cursor":"Layout: side by side"
expect "layout":"side-by-side","effective_layout":"side-by-side"
expect "previewing":true
key escape
key escape
state
expect "overlay":null
expect "layout":"unified","effective_layout":"unified"
expect "previewing":false
key ,
key tab
key e m p h a s i s space o n
state
expect "cursor":"Token emphasis: on"
expect "token_emphasis":true
key escape
key escape
state
expect "token_emphasis":false
expect "previewing":false
key ,
key tab
key a p p r o v e d space s h o w n
state
expect "cursor":"Approved hunks: shown"
expect "approved":"shown"
expect "previewing":true
key escape
key escape
state
expect "approved":"folded"
expect "previewing":false

# Each density previews, moving the diff's rows, while the panel keeps the text size and row
# height it opened with: its rows stay where they were. A font size previews the same way.
key ,
key tab
key d e n s i t y
state
expect "cursor":"Density: compact"
expect "density":"compact","effective_density":"compact"
expect "row_height":26.0
expect "geometry":\{"width":300.0,"text_size":15.0,"row_height":26.0,"list_top":100.0,"cursor_top":126.0\}
key escape
key j
state
expect "density":"normal"
expect "row_height":28.0
expect "geometry":\{"width":300.0,"text_size":15.0,"row_height":26.0,"list_top":100.0,"cursor_top":152.0\}
key j
state
expect "density":"comfortable","effective_density":"comfortable"
expect "previewing":true
expect "row_height":30.0
expect "geometry":\{"width":300.0,"text_size":15.0,"row_height":26.0,"list_top":100.0,"cursor_top":178.0\}
shot 09b-density-preview
key k k
state
expect "geometry":\{"width":300.0,"text_size":15.0,"row_height":26.0,"list_top":100.0,"cursor_top":126.0\}
key escape
state
expect "overlay":null
expect "density":"normal","effective_density":"normal"
expect "previewing":false
expect "row_height":28.0
key ,
key tab
key f o n t space 2 0
state
expect "cursor":"Font size: 20 pt"
expect "font":\{"family":"[^"]+","size":26.66
expect "geometry":\{"width":300.0,"text_size":15.0,"row_height":26.0,"list_top":100.0,"cursor_top":126.0\}
key escape
key escape
state
expect "font":\{"family":"[^"]+","size":17.33
expect "previewing":false

# A preview that has to move a list to fit never moves the place for good: at the end of a
# short file, a small font fits all of it, and dropping the preview scrolls back.
file src/engine.rs
key u
key 0
scroll 5000
state
expect "scroll_offset":524.0,
key ,
key tab
key f o n t
state
expect "cursor":"Font size: 10 pt"
expect "scroll_offset":156.0,
key escape
key escape
state
expect "scroll_offset":(524\.0|523\.99[0-9]*),

# Clicking beside the settings list closes it and gives the keys back to the mode; clicking
# its search field gives the field the keys, as Tab does.
key ,
click 1200 700
state
expect "overlay":null
key ?
state
expect "overlay":"Help"
key escape
key ,
click 100 84
key z j q
state
expect "query":"zjq","searching":true
key escape
key escape
state
expect "overlay":null
key escape

# A file's place is kept by row, not pixels: scrolled in one density, it shows the same line at
# the top after the settings below change the density.
file src/engine.rs
scroll 300
state
expect "rows":\[\{"row":18,"source":15,
file src/compat.rs

# Zed's look, a setting at a time, each found by search and applied with Enter: One Dark, the
# soft style and comfortable rows.
key ,
key tab
key o n e space d a r k
state
expect "cursor":"Theme: One Dark"
key enter
key escape
key escape
key ,
key tab
key s o f t
state
expect "cursor":"Diff style: soft"
key enter
key escape
key escape
key ,
key tab
key c o m f o r t a b l e
state
expect "cursor":"Density: comfortable"
key enter
key escape
key escape
state
expect "diff_style":"soft","theme":"one-dark"
expect "density":"comfortable"
expect "applied_theme":"one-dark"
shot 10-zed
file src/engine.rs
state
expect "rows":\[\{"row":[0-9]+,"source":15,
expect "row_height":30.0
file src/engine.rs

# Screen modes: the diff across the whole width, and back.
key 0
key +
state
expect "screen":"Full"
expect "sidebar":null
key _
state
expect "screen":"Split"

# The title bar: buttons, dragging the bar moves the window, a double click maximizes.
hit 1583 18
expect "region":"close","cursor":"pointer"
hit 800 18
expect "region":"title-bar"
drag 800 18 860 80
state
expect "window_events":\{"move":1\}
click 800 18 2
state
expect "window_events":\{"move":1,"zoom":1\}

# The divider between the files and the diff drags and resets on a double click.
hit 302 500
expect "region":"sidebar-divider"
drag 302 500 400 500
state
expect "sidebar":400.0
click 402 500 2
state
expect "sidebar":300.0

# `/` in the tree filters it as lazygit does: typing narrows it, Enter keeps the filter and
# returns to the list, Esc clears it.
key escape
state
expect "mode":"Tree"
key /
key f o r m
state
expect "area":"Find"
expect "query":"form","editing":true
expect "selected":"src/format.rs"
expect "tree":\[\{"path":"src","kind":"Directory".*\{"path":"src/format.rs","kind":"File".*\],"tree_cursor"
shot 10-tree-filter
key enter
state
expect "area":"Tree"
expect "query":"form","editing":false
key escape
state
expect "filter":null
expect "path":"src/engine.rs"

# `/` in the diff searches its code without leaving it; n and N step through the matches and
# the selected hunk follows. Approved hunks fold, so the file goes back to unreviewed first.
file src/engine.rs
key u
key 0
key /
key b a l a n c e
key enter
key n
key n
state
expect "mode":"Diff"
expect "target":"Diff","query":"balance","matches":5,"current":3
expect "hunk":2,
expect "status":"Match 4 of 5"
shot 11-diff-find
key escape

# Side by side, a move's edits pair too: the source's lines numbered as in src/report.rs on the
# left, the moved lines numbered as in src/format.rs on the right. Panning moves only code, and
# another file starts back at the left edge.
file src/format.rs
key s
state
expect "text":"↙ moved with edits from src/report.rs:9–19
expect "left":\{"kind":"NestedSame","head":2,"base":9,"text":"/// Renders balances
expect "left":\{"kind":"NestedOld","head":null,"base":15,"text":"        out.push_str.*"right":\{"kind":"NestedNew","head":8,
file src/engine.rs
pan 100
state
expect "text_offset":100.0
file src/parser.rs
state
expect "text_offset":0.0
key s
file src/engine.rs

# Side by side, `/` finds each half's code apart, the base's half first in each row, and
# highlights a match only in its own half.
key 0
key s
key /
key b a l a n c e
key enter
state
expect "effective_layout":"side-by-side"
expect "target":"Diff","query":"balance","matches":[0-9]+,"current":[0-9]+,"current_column":"Left"
key n
state
expect "current_column":"Right"
shot 11b-side-by-side-find
key escape
key s
state
expect "layout":"unified"

# Ctrl+P finds a file by a fuzzy match of its path; Enter opens it in the diff.
key ctrl-p
key e n g
state
expect "overlay":"Picker"
expect "area":"Picker"
expect "kind":"Files","scope":"Changed","query":"eng"
expect "entries":\[\{"path":"src/engine.rs","line":null,"text":"","changed":true\}
shot 12-file-finder
key escape
state
expect "area":"PickerList"
key enter
state
expect "overlay":null
expect "mode":"Diff"
expect "selected":"src/engine.rs"

# Ctrl+G searches contents with a preview; a hit inside a hunk opens the diff at that hunk, and
# Tab widens the search to the whole tree, whose unchanged files open read-only.
key ctrl-g
key f n space r e c o n c i l e
state
expect "kind":"Content","scope":"Changed","query":"fn reconcile"
expect "path":"src/engine.rs","line":43
shot 13-content-search
key enter
state
expect "mode":"Diff"
expect "hunk":2,
expect "status":"src/engine.rs:44"
key ctrl-g
key tab
key t i n y
state
expect "scope":"Tree"
expect "path":"README.md","line":2
key enter
state
expect "mode":"Buffer"
expect "title":"README.md"
expect "row":2,"col":2
key escape

# Enter typed before the search answers opens the newest query's first hit, not an older one.
key ctrl-g
key f n space r e c o n c i l e enter
state
expect "overlay":null
expect "status":"src/engine.rs:44"

# A hit on an indented line outside every hunk opens the buffer at the match itself.
key ctrl-g
key s e l f . a p p l i e d enter
state
expect "mode":"Buffer"
expect "row":20,"col":8
key escape
key escape
file src/engine.rs
key space
state
expect "path":"src/engine.rs","kind":"File","change":"M","progress":"Done"

# Holding j in the tree previews files without building every diff; a space right after the
# burst approves exactly the file whose diff shows.
file src/generated/schema.rs
rapid key j
rapid key j
rapid key j
rapid state
expect "preview":true
rapid key space
state
expect "selected":"src/format.rs"
expect "shown":"src/format.rs"
expect "path":"src/format.rs","kind":"File","change":"A","progress":"Done"

# Going back to a file keeps its syntax colors.
file src/parser.rs
key j
key k
state
expect "selected":"src/parser.rs"
expect "highlighted":true

# However a file comes to show, the tree reveals it, so the tree's keys act on what shows: the
# file finder opens a file a filter hides and clears that filter; n and N stay within what the
# filter shows.
key /
key p a r s e r
key enter
key 0
key n
state
expect "selected":"src/parser.rs"
expect "status":"This is the last file\."
key ctrl-p
key r e p o r t
key enter
state
expect "filter":null
expect "selected":"src/report.rs"
key escape
key space
state
expect "path":"src/report.rs","kind":"File","change":"M","progress":"Done"

# A buffer of one file never marks hunks of another file shown since.
file src/engine.rs
key 0
key =
file src/util.rs
key space
state
expect "mode":"Buffer"
expect "status":"Nothing here to review."
expect "pending":0,"queued":0
expect "path":"src/util.rs","kind":"File","change":"M","progress":"Open"
key escape

# A match in unchanged code selects the hunk around it, and a hunk scrolled off screen is
# shown before it can be marked.
key escape
file src/engine.rs
key u
key 0
key /
key i t e r
key enter
state
expect "hunk":2,
resize 1600x400
scroll -5000
key space
state
expect "hunk_badges":\["Unreviewed"\]
expect "status":"Hunk 3 of 3 was off screen
key space
state
expect "status":"Approved hunk 3 of 3
resize 1600x1000
key escape
key space
state
expect "path":"src/engine.rs","kind":"File","change":"M","progress":"Done"

# Folded folders are saved with the review: the relaunch below, on the same data, folds them
# again.
file src/generated/schema.rs
key h
key h
state
expect "collapsed":\["src/generated"\]

# Revision 2 simulates a force-push: approvals carry over where the code is unchanged, and
# hunks that changed since they were reviewed say so.
launch --demo-revision 2
expect "revision":"2"
expect "collapsed":\["src/generated"\]
expect "trusted":true
file src/engine.rs
find changed since
state
expect "tag":"changed since revision 1"
shot 09-revision-2

# A mark that lands while a held key previews a file by its header never builds that file's
# diff early: it still opens at its first hunk that needs the reviewer once the cursor rests.
launch --demo
file src/generated/schema.rs
rapid key j
rapid key space
rapid key j
rapid state
expect "selected":"src/engine.rs","shown":"src/engine.rs","preview":true
state
expect "selected":"src/engine.rs"
expect "hunk":1,

# A mistake in one diff style costs only that style, and the window says so where the reviewer
# looks, not only on stderr.
launch --demo --config scripts/qa/broken-style.toml
expect "status":"Configuration: \[styles.calm\] cannot be used: it sets density
expect "diff_style":"soft"

# A font size past what zoom allows opens at the largest zoom does; the screenshot shows the
# chrome scaled with it, with bars holding their text and columns kept apart.
launch --demo --font-size 100
expect "font":\{"family":"[^"]*","size":40\.0
file src/engine.rs
key 0
shot 30-largest-font

include scripts/qa/smoke-quit.qa
