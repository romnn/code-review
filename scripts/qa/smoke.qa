# Walks the built-in demo the lazygit way: files, one file's diff, hunks approved and flagged,
# the whole file as a buffer, overlays, input racing background work, window chrome, themes,
# and a force-push. Run with `task qa -- scripts/qa/smoke.qa`; screenshots land in target/qa/.

launch --demo
expect "revision":"1"
expect "mode":"Tree"
expect "client_decorated":true
expect "theme":"carbonfox"
expect "token_emphasis":false,"diff_style":"syntax"
shot 01-open

# Moving through the files previews each one's diff.
file src/engine.rs
state
expect "selected":"src/engine.rs"
expect "hunks":3
expect "scope":"impl Ledger › fn apply_batch"
shot 02-engine

# The diff starts at the first hunk that needs the reviewer; j/k move between hunks, and
# space approves and moves on to the next open hunk.
key 0
state
expect "mode":"Diff"
expect "hunk":1,
expect "hunk_badges":\["Unreviewed"\]
key space
state
expect "hunk":2,
key k
state
expect "hunk_badges":\["Accepted"\]
shot 03-approved
# Space again takes it back; ! flags and u resets.
key space
state
expect "hunk_badges":\["Unreviewed"\]
key !
state
expect "hunk_badges":\["Flagged"\]
key u
state
expect "hunk_badges":\["Unreviewed"\]

# The whole file as a read-only buffer, at the selected hunk, with vim motions and find.
key =
state
expect "mode":"Buffer"
expect "row":26,
key j
key w
state
expect "row":27,"col":12
expect "scope":"impl Ledger › fn apply_batch"
key /
key b a l a n c e
key enter
key n
state
expect "query":"balance","matches":12
expect "scope":"impl Ledger › fn balance"
expect "editing":false
shot 04-buffer-find
key escape
key escape
state
expect "mode":"Diff"
expect "hunk":1,

# Overlays own the keyboard: review keys under them do nothing.
key ?
key space
key j
state
expect "overlay":"Help"
expect "hunk":1,
expect "hunk_badges":\["Unreviewed"\]
shot 05-help
key escape
key i
key space
state
expect "overlay":"Overview"
expect "hunk_badges":\["Unreviewed"\]
key q
state
expect "overlay":null

# Input racing background work: approve, then leave for other files before the mark is saved.
# The mark lands on exactly the hunk approved, and the view follows the latest selection.
rapid key space
rapid key escape
rapid key j
rapid key j
state
expect "mode":"Tree"
expect "selected":"src/hash.rs"
expect "pending":0,"queued":0
expect "path":"src/engine.rs","kind":"File","change":"M","progress":"Partial"
file src/engine.rs
key 0
state
expect "hunk":2,
key k
state
expect "hunk_badges":\["Accepted"\]

# Plain red and green instead of syntax on tinted rows.
key |
state
expect "diff_style":"plain"
shot 06-plain
key |

# Approving a whole file from the tree, as lazygit stages one.
key escape
key space
state
expect "path":"src/engine.rs","kind":"File","change":"M","progress":"Done"
shot 07-file-done

# Themes.
key shift-t
state
expect "theme":"tokyonight-night"
shot 08-tokyonight
key shift-t
key shift-t
key shift-t
key shift-t
key shift-t
key shift-t
key shift-t
key shift-t
state
expect "theme":"carbonfox"

# Screen modes: the diff across the whole width, and back.
key 0
key +
state
expect "screen":"Full"
expect "sidebar":null
key _
state
expect "screen":"Split"

# The title bar: buttons, dragging the bar moves the window, a double click maximizes.
hit 1583 18
expect "region":"close","cursor":"pointer"
hit 800 18
expect "region":"title-bar"
drag 800 18 860 80
state
expect "window_events":\{"move":1\}
click 800 18 2
state
expect "window_events":\{"move":1,"zoom":1\}

# The divider between the files and the diff drags and resets on a double click.
hit 302 500
expect "region":"sidebar-divider"
drag 302 500 400 500
state
expect "sidebar":400.0
click 402 500 2
state
expect "sidebar":300.0

# Revision 2 simulates a force-push: approvals carry over where the code is unchanged, and
# hunks that changed since they were reviewed say so.
launch --demo-revision 2
expect "revision":"2"
expect "trusted":true
file src/engine.rs
find changed since
state
expect "tag":"changed since revision 1"
shot 09-revision-2
